# SatQuery AI — environment template
# Copy to `.env` (gitignored) and edit for your deployment.

# API key required for /api/process-query and /api/export-report.
# Leave blank in dev for an open server (warning logged at startup).
SATQUERY_API_KEY=

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# Directory the FastAPI server treats as the upload sandbox.
SATQUERY_UPLOADS_DIR=uploads

# HuggingFace token (only needed for gated VLM downloads).
HF_TOKEN=
